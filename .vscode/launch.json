{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch in dgb",
            "type": "cppdbg",
            "request": "launch",

            // This will trigger the "make all" task from tasks.json
            "preLaunchTask": "make all",
            // We are not using the binary from the build folder because we do not want to run the "make install" task.
            // The "make install" task is only to generate the default naemon configurtion files
            "program": "${workspaceFolder}/src/naemon/.libs/naemon",
            "args": [
                //"--help",
                "${workspaceFolder}/build/etc/naemon/naemon.cfg"
            ],
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/.libs"
                }
            ],

            // Optional parameter. If true, the debugger should stop at the entrypoint of the target.
            "stopAtEntry": true,


            "launchCompleteCommand": "exec-run",
            "MIMode": "gdb",

            // Especially when working with the Query Handler "Broken Pipe" issues may occur. In this case it is useful to ignore SIGPIPE.
            //"setupCommands": [
            //    {
            //        "description": "Ignore SIGPIPE",
            //        "text": "handle SIGPIPE nostop noprint pass"
            //    }
            //],

            "miDebuggerPath": "/usr/bin/gdb",
          },
          // Same as above, but prepared for developing event broker modules,
          // for example mod_gearman or the statusengine broker. Works both in
          // the dev container (see ../.devcontainer) and on native Linux.
          {
            "name": "Launch in gdb (with broker modules)",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "make all",
            "program": "${workspaceFolder}/src/naemon/.libs/naemon",
            "args": [
                "${workspaceFolder}/build/etc/naemon/naemon.cfg"
            ],
            "cwd": "${workspaceFolder}",
            // Deliberately only .libs, not build/lib: broker modules are loaded
            // by absolute path and their "NEEDED libnaemon.so.0" is resolved
            // through this variable. Adding build/lib could pick up the stale
            // copy from the last "make install" and you would debug against
            // sources that no longer match the library.
            "environment": [
                { "name": "LD_LIBRARY_PATH", "value": "${workspaceFolder}/.libs" }
            ],
            // Stopping at the entry point would just mean stepping all the way
            // to neb_load_all_modules() before anything module related happens.
            "stopAtEntry": false,
            "launchCompleteCommand": "exec-run",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                // Breakpoints in module sources cannot be resolved before the
                // module has been dlopen()ed in neb_load_module().
                { "description": "Allow breakpoints in modules that are not loaded yet",
                  "text": "set breakpoint pending on" },
                { "description": "Do not stop every time module symbols are loaded",
                  "text": "set stop-on-solib-events 0" },
                // Broker modules talk to sockets, just like the Query Handler.
                { "description": "Ignore SIGPIPE",
                  "text": "handle SIGPIPE nostop noprint pass" }
            ]
          }
    ]
}
